PORT=3000
# Server-side only. NEVER expose to the browser / Vite env.
G8_API_KEY=your_graph8_api_key_here
# Optional alias accepted by config: GRAPH8_API_KEY
GRAPH8_BASE_URL=https://be.graph8.com/api/v1
# Server-side only. Used for raw-body HMAC verification (X-G8-Signature).
GRAPH8_WEBHOOK_SECRET=your_webhook_signing_secret_here
# Landing page template key used in the page-cache key.
GRAPH8_PAGE_TEMPLATE=lead_magnet
# Optional: explicit target-account domains/names (comma-separated).
# Only these can ever classify as target_account.
GRAPH8_TARGET_ACCOUNTS=
# Intent thresholds: score >= HIGH is high intent, >= MEDIUM is medium.
GRAPH8_INTENT_THRESHOLD=60
# Optional: voice agent for real AI sales-prep scripts. If missing,
# preparation falls back to a clearly labelled simulation.
GRAPH8_VOICE_AGENT_ID=your_voice_agent_id_here
# Optional alias: GRAPH8_VOICE_AGENT
