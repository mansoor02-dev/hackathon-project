# ============================================================================
# Signal Desk — backend env template. Copy-paste to `.env`, then fill values:
#   cd backend && cp .env.example .env
# `.env` is gitignored (see backend/.gitignore) — secrets never go to GitHub.
# NOTHING here is real. Replace every PASTE_* placeholder with your own value.
# ============================================================================

PORT=3000

# REQUIRED. Server-side only — NEVER put this in the frontend / Vite env.
# Where: Graph8 → Settings → MCP & API → API key.
G8_API_KEY=PASTE_YOUR_GRAPH8_API_KEY_HERE
# Optional alias accepted by config: GRAPH8_API_KEY (use one, G8_API_KEY wins).

# Optional. Defaults to https://be.graph8.com/api/v1 when unset.
GRAPH8_BASE_URL=https://be.graph8.com/api/v1

# REQUIRED for webhooks. Server-side only.
# Where: Graph8 → same MCP & API / webhook area → signing secret.
# IMPORTANT: every webhook 401s while this is empty or mismatched.
GRAPH8_WEBHOOK_SECRET=PASTE_YOUR_WEBHOOK_SIGNING_SECRET_HERE

# Optional. Template key used in the landing-page cache key.
GRAPH8_PAGE_TEMPLATE=lead_magnet

# RECOMMENDED for the demo. 2-3 real customer domains, comma-separated.
# Only these can ever classify as target_account (strongest personalization).
# Example: GRAPH8_TARGET_ACCOUNTS=acme.com,globex.com
GRAPH8_TARGET_ACCOUNTS=

# Optional. Score >= HIGH is high intent, >= 40 is medium. Default 60.
GRAPH8_INTENT_THRESHOLD=60

# RECOMMENDED for the demo. Real AI sales-prep scripts after a booked meeting.
# Where: Graph8 voice agent id. Unset = clearly labelled simulation (also demo-able).
# Optional alias: GRAPH8_VOICE_AGENT
GRAPH8_VOICE_AGENT_ID=PASTE_YOUR_VOICE_AGENT_ID_HERE

# --- Inbound -> Outbound Recovery (Graph8 Sequencer owns timing) ---
# Recovery segmentation list. ID wins when set; otherwise TITLE is found-or-created once.
# Where: Graph8 → Lists → open your list → id from the URL. (This workspace: id 3 = "Recovery List".)
GRAPH8_RECOVERY_LIST_ID=
GRAPH8_RECOVERY_LIST_TITLE=Signal Desk — Recovery

# REQUIRED for live outreach, optional for the demo.
# Where: Graph8 → Sequences → open your sequence → id from the URL.
# Empty = recovery still works and displays "Sequence not configured".
GRAPH8_RECOVERY_SEQUENCE_ID=

# SAFETY. Keep false for the demo and all tests.
# false = "Ready for Sequence" preview, nothing is ever sent to anyone.
# true (+ sequence id) = real enrollment via g8.sequences.add (may send outreach).
GRAPH8_RECOVERY_AUTO_ENROLL=false

# Optional. Graph8 Workflow covering part of the recovery flow (validate+execute).
# Empty = workflow integration reports NOT_CONFIGURED, core flow unaffected.
GRAPH8_RECOVERY_WORKFLOW_ID=

# Optional. Graph8 Skills: account qualification / contact selection / outreach prep.
# Empty = local logic is used, reported honestly. Never executed during tests.
GRAPH8_SKILL_QUALIFICATION_ID=
GRAPH8_SKILL_CONTACT_ID=
GRAPH8_SKILL_OUTREACH_ID=
