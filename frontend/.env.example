# Frontend env template. Copy to `.env.local` (gitignored) — no secrets here, ever.
# Backend address the Vite dev proxy forwards /health + /api to.
BACKEND_PROXY_TARGET=http://127.0.0.1:3000
# Empty = same origin (requests go through the dev proxy above). Only set this
# when the frontend is served from somewhere other than the dev proxy.
VITE_API_BASE_URL=
